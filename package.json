{
  "name": "pixel-pandemonium-server",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel Pandemonium replay data store and realtime backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "./test.sh",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "./test.sh",
    "cloudflare:dev": "wrangler dev --local",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:tail": "wrangler tail",
    "cloudflare:db:create": "wrangler d1 create pixel-pandemonium",
    "cloudflare:db:migrate:local": "wrangler d1 migrations apply pixel-pandemonium --local",
    "cloudflare:db:migrate:remote": "wrangler d1 migrations apply pixel-pandemonium --remote"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "faye": "^1.4.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.16.0"
  }
}
