{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-pandemonium-server",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-06-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBSUB",
        "class_name": "PubSubRoom"
      },
      {
        "name": "RATELIMIT",
        "class_name": "RateLimitBucket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PubSubRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimitBucket"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-pandemonium",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4000,https://billmongan.com,https://billjr99.github.io,https://jaheimoates-him.github.io",
    "CLIENT_BASE_URL": "http://localhost:4000",
    "DEFAULT_EXPIRATION_HOURS": "8760",
    "RATE_LIMIT_MAX_PER_SECOND": "3",
    "RATE_LIMIT_MAX_PER_MINUTE": "20",
    "RATE_LIMIT_MAX_PER_DAY": "10000",
    "AUTH_FAILURE_LIMIT": "5",
    "AUTH_FAILURE_WINDOW_MINUTES": "10",
    "AUTH_ADMIN_BAN_DAYS": "1",
    "AUTH_TEACHER_BAN_MINUTES": "10",
    "AUTH_STUDENT_BAN_MINUTES": "10",
    "ADMIN_PASSWORD": "admin",
    "DOWNLOAD_TOKEN": "change-me-before-deploying",
    "LEGACY_ROUTES_ENABLED": "true"
  }
}
